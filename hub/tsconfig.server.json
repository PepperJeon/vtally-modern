{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "outDir": "dist",
    "noEmit": false,
    "moduleResolution": "node",
    "isolatedModules": false,
  },
  // The server build is server/ + shared/ only. client/ is Vite's job and is
  // ESM (import.meta), which cannot compile under module:commonjs.
  "include": [
    "src/server",
    "src/shared"
  ],
  "exclude": [
    "**/*.spec.*"
  ]
}
