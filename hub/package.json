{
  "name": "vtally",
  "version": "0.5.2",
  "private": true,
  "license": "MIT",
  "main": "dist/app/electron/main.js",
  "dependencies": {
    "@julusian/midi": "^3.7.2",
    "atem-connection": "^3.0.0-nightly-latest-20211125-222857-2b30eea.0",
    "escape-string-regexp": "^4.0.0",
    "express": "^4.17.2",
    "forever-monitor": "^3.0.3",
    "http-proxy-middleware": "^1.3.1",
    "nodemcu-tool": "github:PepperJeon/NodeMCU-Tool#9b5f8d027042155d35ffbcfb33af7fb941c4bdd5",
    "obs-websocket-js": "^5.0.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tmp-promise": "^3.0.3",
    "xml2js": "^0.4.23",
    "yargs": "^15.4.1"
  },
  "scripts": {
    "start:frontend": "vite",
    "start:backend": "ts-node --project tsconfig.server.json src/server/server.ts --env=development",
    "build:frontend": "vite build",
    "build:backend": "tsc --project tsconfig.server.json",
    "build:electron": "tsc --project tsconfig.electron.json && vite build --outDir dist/app/src/server/frontend --emptyOutDir",
    "start:electron": "npm run build:electron && electron .",
    "pack:electron": "npm run build:electron && electron-builder --dir",
    "test": "vitest",
    "test:ci": "vitest run",
    "cypress:open": "cypress open",
    "cypress:backend": "ts-node --project tsconfig.server.json src/server/server.ts --env=development --with-test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^5.16.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^12.8.3",
    "@types/express": "^4.17.13",
    "@types/jest": "^26.0.24",
    "@types/node": "^12.20.39",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-router": "^5.1.17",
    "@types/react-router-dom": "^5.3.2",
    "@types/tmp": "^0.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "cypress": "^15.19.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint-plugin-cypress": "^2.12.1",
    "jsdom": "^29.1.1",
    "lato-font": "^3.0.0",
    "lucide-react": "^1.27.0",
    "nosleep.js": "^0.12.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^5.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tmp": "^0.2.7",
    "ts-node": "^9.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "web-vitals": "^0.2.4",
    "ws": "^8.21.1"
  },
  "build": {
    "extends": null,
    "appId": "so.vtally.hub",
    "productName": "vTally",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/app/**"
    ],
    "asarUnpack": [
      "node_modules/@julusian/midi/**",
      "node_modules/serialport/**",
      "node_modules/@serialport/**",
      "node_modules/nodemcu-tool/**"
    ],
    "extraResources": [
      {
        "from": "../tally/out",
        "to": "esp8266"
      }
    ]
  },
  "engines": {
    "node": ">=16",
    "npm": ">=6.9"
  },
  "os": [
    "linux",
    "win32",
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm",
    "arm64"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
