  "author": "peperjeon (Modernization) / Original: wifi-tally team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/peperjeon/vtally-modern.git"
  },
  "homepage": "https://github.com/peperjeon/vtally-modern",
  "keywords": [
    "vtally",
    "tally-light",
    "obs-studio",
    "vmix",
    "atem",
    "roland",
    "electron",
    "vite",
    "react",
    "tailwind",
    "wifi",
    "esp8266",
    "video-production"
  ],
  "private": true,
  "main": "out/main/index.js",
  "dependencies": {
    "@julusian/midi": "^3.6.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "atem-connection": "^3.0.0-nightly-latest-20211125-222857-2b30eea.0",
    "escape-string-regexp": "^4.0.0",
    "events": "^3.3.0",
    "express": "^4.17.2",
    "forever-monitor": "^3.0.3",
    "http-proxy-middleware": "^1.3.1",
    "i18next": "^25.7.4",
    "nodemcu-tool": "github:wifi-tally/NodeMCU-Tool",
    "obs-websocket-js": "^5.0.5",
    "react-i18next": "^16.5.1",
    "socket.io": "^2.4.1",
    "socket.io-client": "^2.4.0",
    "tmp-promise": "^3.0.3",
    "xml2js": "^0.4.23",
    "yargs": "^15.4.1"
