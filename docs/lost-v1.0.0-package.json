  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite",
    "build": "electron-vite build",
    "build:backend": "tsc --project tsconfig.server.json",
    "start": "electron-vite dev",
    "package": "electron-vite build",
    "start:backend": "node dist/server.js --env=development",
    "test": "vitest",
    "test:ci": "vitest run",
    "cypress:open": "cypress open",
    "cypress:backend": "node dist/server.js --env=development --with-test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@material-ui/core": "^4.12.3",
    "@material-ui/icons": "^4.11.2",
    "@material-ui/lab": "^4.0.0-alpha.60",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^11.2.7",
    "@testing-library/user-event": "^12.8.3",
    "@types/express": "^4.17.13",
    "@types/jest": "^26.0.24",
    "@types/node": "^12.20.55",
    "@types/react": "^16.14.21",
    "@types/react-dom": "^16.9.14",
    "@types/react-router": "^5.1.17",
    "@types/react-router-dom": "^5.3.2",
    "@types/socket.io": "^2.1.13",
    "@types/socket.io-client": "^1.4.36",
    "@types/tmp": "^0.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.0.16",
    "cross-env": "^7.0.3",
    "cypress": "^6.9.1",
    "electron": "^33.0.2",
    "electron-vite": "^5.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^2.12.1",
    "jsdom": "^27.4.0",
    "lato-font": "^3.0.0",
    "nosleep.js": "^0.12.0",
    "prettier": "^3.7.4",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-full-screen": "^0.3.2-0",
    "react-router-dom": "^5.3.0",
    "ts-node": "^9.0.0",
    "typescript": "^4.5.4",
    "vite": "^5.4.21",
    "vitest": "^4.0.16",
    "web-vitals": "^0.2.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "os": [
    "linux",
    "win32",
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm",
    "arm64"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.vtally.app",
    "productName": "vTally",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "build/**/*",
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "icon": "public/logo192.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/logo192.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Video",
      "icon": "public/logo192.png"
    }
  }
}
